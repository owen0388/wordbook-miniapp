/* 学习会话 */

.session {
  padding-bottom: 80rpx;
}

.s-head {
  margin-bottom: 24rpx;
}

/* 进度条：一条走完全程，但按阶段分色。
   底色 = 新词段（淡珊瑚），左侧叠一段 = 复习段（淡靛蓝），
   再叠一条主色填充 = 已完成。这样未完成的部分一眼能看出
   "接下来是复习还是新词"。 */
.bar.s-bar {
  margin-top: 18rpx;
  height: 16rpx;
  background: var(--accent-soft);
}

.bar-seg {
  position: absolute;
  top: 0;
  bottom: 0;
  border-radius: var(--r-pill);
  background: #E1E8F7;
}

/* 填充要盖在分段之上 */
.s-bar .bar-fill {
  z-index: 2;
  transition: width 0.45s var(--ease);
}

/* 进度数字：真机上原来太小，看不清 */
.s-count {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-sub);
  font-variant-numeric: tabular-nums;
}

/* 结构提示：原来是 22rpx，真机偏小 */
.s-note {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-sub);
}

/* 中途鼓励：浮在顶部，不占布局、不遮挡题目 */
.s-milestone {
  position: fixed;
  top: 170rpx;
  left: 50%;
  z-index: 30;
  padding: 20rpx 40rpx;
  border-radius: var(--r-pill);
  background: rgba(39, 56, 110, 0.95);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  transform: translateX(-50%);
  animation: msPop 0.32s var(--spring);
  pointer-events: none;
  box-shadow: 0 12rpx 32rpx -10rpx rgba(26, 39, 80, 0.6);
}

@keyframes msPop {
  from { opacity: 0; transform: translateX(-50%) translateY(-14rpx) scale(0.92); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
}

/* 顶部阶段标签：全局 .tag 是 22rpx，真机上偏小，这里覆盖一下 */
.s-head .tag {
  font-size: 26rpx;
  padding: 8rpx 24rpx;
}

/* 卡片 */
.s-card {
  text-align: center;
  padding: 56rpx 36rpx 48rpx;
}

.s-tag {
  display: inline-block;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #B03D0F;
  background: linear-gradient(135deg, #FFE3D3, #FFD5C0);
  padding: 8rpx 24rpx;
  border-radius: var(--r-pill);
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 10rpx -4rpx rgba(242, 84, 42, 0.6);
}

.s-word {
  font-size: 84rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.14;
  letter-spacing: -0.01em;
  word-break: break-all;
}

/* 单词 + 喇叭：居中对齐，喇叭不参与换行 */
.s-word-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.s-spk {
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #F2F6FF, #E3EAF9);
  box-shadow: 0 4rpx 0 #CBD6EC, 0 8rpx 16rpx -8rpx rgba(39, 56, 110, 0.4);
  transition: transform 0.12s var(--ease), box-shadow 0.12s;
}
.s-spk:active {
  transform: translateY(4rpx);
  box-shadow: 0 0 0 #CBD6EC;
}

/* 插件未启用时保留位置但不显眼，避免布局跳动 */
.s-spk-off {
  opacity: 0.35;
}

.s-word-cn {
  font-size: 52rpx;
  font-weight: 600;
  color: var(--primary);
  line-height: 1.4;
}

.s-phonetic {
  font-size: 30rpx;
  color: var(--muted);
  margin-top: 16rpx;
}

.s-meaning {
  font-size: 40rpx;
  font-weight: 600;
  text-align: left;
  margin-bottom: 28rpx;
}

.s-pos {
  font-size: 24rpx;
  color: var(--accent);
  background: var(--accent-soft);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 14rpx;
}

.s-example {
  background: var(--bg);
  border-radius: 14rpx;
  padding: 24rpx;
  text-align: left;
}

.s-ex-en {
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 8rpx;
}

.s-ex-cn {
  font-size: 24rpx;
  color: var(--muted);
}

.s-hint {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-top: 32rpx;
}

.s-btn {
  margin-top: 32rpx;
}

.s-card-btn {
  margin-top: 0;
}

/* 选项 */
.opts {
  margin-top: 8rpx;
}

.opt {
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  padding: 32rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  color: var(--text);
  box-shadow: 0 4rpx 0 rgba(26, 39, 80, 0.05);
  transition: transform 0.13s var(--ease), border-color 0.13s, box-shadow 0.13s, background 0.13s;
}
.opt:active {
  transform: translateY(4rpx);
  border-color: #B4C4E5;
  box-shadow: 0 0 0 rgba(26, 39, 80, 0.05);
}

.opt-right {
  background: var(--success-soft);
  border-color: var(--success);
  color: #06714F;
  font-weight: 700;
  box-shadow: 0 4rpx 0 rgba(12, 154, 108, 0.25);
  animation: wbPopIn 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.opt-wrong {
  background: var(--danger-soft);
  border-color: var(--danger);
  color: #A93236;
  font-weight: 700;
  box-shadow: 0 4rpx 0 rgba(216, 71, 74, 0.2);
  animation: wbShake 0.45s var(--ease) both;
}

/* 输入作答 */
.ans {
  margin-top: 8rpx;
}

.ans-input {
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  height: 108rpx;
  padding: 0 32rpx;
  font-size: 34rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(26, 39, 80, 0.04);
}

/* 判分反馈 */
.fb {
  border-radius: var(--r-md);
  padding: 30rpx;
  margin-top: 8rpx;
  border: 2rpx solid transparent;
}

.fb-right {
  background: linear-gradient(135deg, #E7FAF2, #DAF5EA);
  border-color: rgba(12, 154, 108, 0.28);
  box-shadow: 0 10rpx 30rpx -16rpx rgba(12, 154, 108, 0.6);
  animation: wbPopIn 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.fb-wrong {
  background: linear-gradient(135deg, #FDEEED, #FBE4E3);
  border-color: rgba(216, 71, 74, 0.26);
  box-shadow: 0 10rpx 30rpx -16rpx rgba(216, 71, 74, 0.5);
  animation: wbShake 0.5s var(--ease) both;
}

.fb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.fb-title {
  font-size: 32rpx;
  font-weight: 600;
}

.fb-right .fb-title { color: var(--success); }
.fb-wrong .fb-title { color: var(--danger); }

.fb-badge {
  font-size: 22rpx;
  opacity: 0.8;
}

.fb-right .fb-badge { color: var(--success); }
.fb-wrong .fb-badge { color: var(--danger); }

.fb-correct {
  font-size: 28rpx;
  color: var(--danger);
  margin-bottom: 16rpx;
}

.fb-detail {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.fb-w {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--primary);
}

.fb-p {
  font-size: 26rpx;
  color: var(--muted);
}

.fb-m {
  font-size: 28rpx;
  color: var(--text);
}

/* 抽查未过关 */
.gate {
  text-align: center;
  padding: 64rpx 40rpx;
}

.gate-score {
  font-size: 112rpx;
  font-weight: 700;
  color: var(--danger);
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
}

.gate-pct {
  font-size: 44rpx;
}

.gate-title {
  font-size: 34rpx;
  font-weight: 600;
  margin: 20rpx 0 20rpx;
}

.gate-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
  margin-bottom: 16rpx;
  text-align: left;
}

.gate-skip {
  margin-top: 20rpx;
}
