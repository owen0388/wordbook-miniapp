/* 结算页 */

.hero {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(110% 130% at 50% 0%, #40569C 0%, rgba(64, 86, 156, 0) 60%),
    linear-gradient(158deg, #2D4079 0%, #19264D 100%);
  border-radius: var(--r-lg);
  padding: 56rpx 36rpx 48rpx;
  margin-bottom: 22rpx;
  color: #fff;
  text-align: center;
  box-shadow: 0 20rpx 44rpx -22rpx rgba(25, 38, 77, 0.8);
}

.hero::after {
  content: '';
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  left: 50%;
  top: -200rpx;
  margin-left: -160rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 0 0 40rpx rgba(255, 255, 255, 0.04), 0 0 0 86rpx rgba(255, 255, 255, 0.025);
  pointer-events: none;
}

/* 这枚小胶囊是整页的情绪落点：先弹出来，再读下面的数字 */
.hero-emoji {
  position: relative;
  display: inline-block;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  padding: 8rpx 26rpx;
  border-radius: var(--r-pill);
  background: linear-gradient(135deg, #FF9A5E, #F2542A);
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 0 #C7431C, 0 16rpx 30rpx -12rpx rgba(242, 84, 42, 0.9);
  animation: wbPopIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.hero-title {
  position: relative;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
  margin-bottom: 16rpx;
  letter-spacing: -0.01em;
}

.hero-sub {
  position: relative;
  font-size: 24rpx;
  opacity: 0.8;
}

/* 第二行副文案（一句人话点评），和上一行拉开一点 */
.hero-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  opacity: 0.7;
}

.acc {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}

/* 累计区块：把"我变强了"讲成一句话，而不是再摆一排数字 */
.acc-line {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
}

.acc-num {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
  margin: 0 6rpx;
}

.acc-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}

.mt {
  margin-top: 20rpx;
}
