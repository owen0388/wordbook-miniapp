/* ============ 结算页 · 积木世界 ============ */

/* --- 大星星 ---
 * 用 clip-path 画五角星，比文字 ★ 饱满得多，且任意尺寸不糊。
 * clip-path 无法描边，所以外圈描边用 drop-shadow 模拟。
 */
.star-wrap {
  position: relative;
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
}
.halo {
  position: absolute;
  width: 454rpx;
  height: 454rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,224,122,.55) 0%, rgba(255,201,61,.22) 46%, transparent 70%);
  animation: wbPulse 3s ease-in-out infinite;
}
.bigstar {
  position: relative;
  width: 319rpx;
  height: 319rpx;
  /* clip-path 不生效时的兜底形状：圆角方块，总比裸方块好看 */
  border-radius: 22%;
  background-image: linear-gradient(160deg, #FFE07A 0%, #FFC53D 52%, #E8A420 100%);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  filter: drop-shadow(0 6rpx 0 rgba(160,110,10,.55)) drop-shadow(0 10rpx 16rpx rgba(140,90,0,.4));
  animation: starIn .62s var(--spring) both;
}
@keyframes starIn {
  0% { opacity: 0; transform: scale(.5) rotate(-16deg); }
  60% { opacity: 1; transform: scale(1.08) rotate(4deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); }
}
.bigstar-in {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 笑脸：两颗眼 + 一条弧线嘴 */
.star-face {
  position: relative;
  width: 130rpx;
  height: 110rpx;
  margin-top: 34rpx;
}
.sf-eye {
  position: absolute;
  top: 10rpx;
  width: 22rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #8A5A08;
}
.sf-eye.l { left: 16rpx; }
.sf-eye.r { right: 16rpx; }
.sf-mouth {
  position: absolute;
  left: 28rpx; right: 28rpx;
  top: 52rpx;
  height: 32rpx;
  border: 6rpx solid #8A5A08;
  border-top: none;
  border-left-color: transparent;
  border-right-color: transparent;
  border-radius: 0 0 60rpx 60rpx / 0 0 40rpx 40rpx;
}

/* --- 标题区 --- */
.res-title {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--ink);
  text-align: center;
  line-height: 1.32;
  margin-top: 8rpx;
}
.res-sub {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--ink-3);
  text-align: center;
  margin-top: 12rpx;
}
.res-note {
  font-size: 23rpx;
  color: var(--ink-mute);
  text-align: center;
  margin-top: 8rpx;
  padding: 0 40rpx;
  line-height: 1.6;
}

/* --- 内容卡片 --- */
.plate {
  margin-top: 40rpx;
  margin-bottom: 32rpx;
  padding: 32rpx 6.5% 6.5%;
}

.acc {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--accent-deep);
  font-variant-numeric: tabular-nums;
}
.acc-line {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--ink);
  font-weight: 700;
}
.acc-num {
  font-size: 42rpx;
  font-weight: 900;
  color: var(--accent-hot);
  font-variant-numeric: tabular-nums;
  margin: 0 6rpx;
}
.acc-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-mute);
}
.mt { margin-top: 20rpx; }

/* --- 按钮 --- */
.res-btn {
  width: 100%;
  height: 104rpx;
  margin-top: 40rpx;
  transform: rotate(.6deg);
}
.res-btn.btn-press { transform: rotate(.6deg) translateY(7rpx) scale(.992); }
.res-btn-2 {
  margin-top: 28rpx;
  height: 96rpx;
  transform: rotate(-.5deg);
}
.res-btn-2.btn-press { transform: rotate(-.5deg) translateY(6rpx) scale(.992); }
