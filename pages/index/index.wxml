<view class="page-in page">

  <view class="fx-glow"></view>
  <view class="fx-bg"></view>

  <!-- ===== 顶部英雄积木 ===== -->
  <view class="hero brick">
    <view class="studs lg">
      <view class="pt"></view><view class="pt"></view><view class="pt"></view>
      <view class="pt"></view><view class="pt"></view>
    </view>

    <!-- 顶部压印品牌：刻在积木顶面上的字，不是第二个标题 -->
    <view class="hero-brand">
      <view class="hb-rule"></view>
      <text class="hb-cn">单词秒记</text>
      <view class="hb-rule"></view>
    </view>

    <!-- 日期条 -->
    <view class="datebar">
      <view class="studs thin">
        <view class="pt"></view><view class="pt"></view><view class="pt"></view>
        <view class="pt"></view><view class="pt"></view>
      </view>
      <text class="dt sticker">{{dateText}} · {{weekdayText}}</text>
      <view class="sk">连续 <text class="sk-num">{{overall.streak}}</text> 天</view>
    </view>

    <!-- 吉祥物：柯基豆豆。点一下会跳、会说话；连点三下冒爱心 -->
    <view class="hero-pup" bindtap="onPupTap" hover-class="none" hover-stop-propagation>
      <image
        class="mascot {{pupHop ? 'pup-hop' : ''}}"
        src="/assets/images/mascot-corgi.png"
        mode="widthFix" />
      <view class="pup-say" wx:if="{{pupLine}}">{{pupLine}}</view>
      <block wx:if="{{pupLove}}">
        <text class="pup-heart h1">♥</text>
        <text class="pup-heart h2">♥</text>
        <text class="pup-heart h3">♥</text>
      </block>
    </view>

    <view class="hero-h1 sticker sticker-lg">
      {{doneToday ? '今天已通关' : '今天也要'}}<text class="hero-h1-b">{{doneToday ? '真棒！' : '记单词！'}}</text>
    </view>

    <view class="hero-tip sticker" wx:if="{{hasShelf && !doneToday && reduced}}">
      昨天没做完，今天只学 {{newCount}} 个新词
    </view>
    <view class="hero-tip sticker" wx:elif="{{hasShelf && !doneToday}}">
      今天还有 {{reviewCount + newCount}} 件事要做
    </view>
    <view class="hero-tip sticker" wx:elif="{{doneToday}}">
      今天该做的做完了，明天见
    </view>
  </view>

  <!-- ===== 今日任务 ===== -->
  <view class="card plate">
    <view class="studs">
      <view class="pt"></view><view class="pt"></view>
      <view class="pt"></view><view class="pt"></view>
    </view>

    <view class="sec-head">
      <text class="sec-title">今日任务</text>
      <text class="sec-link" wx:if="{{hasShelf && !doneToday}}">复习优先 ›</text>
    </view>

    <block wx:if="{{hasShelf}}">

      <!-- 已完成 -->
      <block wx:if="{{doneToday && todaySummary}}">
        <view class="done-box">
          <view class="done-badge sticker">今天已完成</view>
          <view class="done-title">{{todaySummary.title}}</view>
          <view class="done-sub">连续第 {{overall.streak}} 天 · 用时 {{todaySummary.durationText}}</view>
          <view class="done-stats">
            <text class="done-stat">新词 {{todaySummary.newCount}}</text>
            <text class="done-sep">·</text>
            <text class="done-stat">复习 {{todaySummary.reviewCount}}</text>
            <text class="done-sep">·</text>
            <text class="done-stat">正确率 {{todaySummary.accuracy}}%</text>
          </view>
        </view>
        <button hover-class="btn-press" class="btn btn-primary task-btn" bindtap="goResult">查看今日总结</button>
        <view class="task-note">今天该做的做完了，明天见</view>
      </block>

      <!-- 未完成 -->
      <block wx:else>
        <view class="stat-grid">
          <view class="stat">
            <view class="studs sm"><view class="pt"></view><view class="pt"></view></view>
            <view class="stat-num">{{reviewCount}}</view>
            <view class="stat-label">待抽查</view>
          </view>
          <view class="stat">
            <view class="studs sm"><view class="pt"></view><view class="pt"></view></view>
            <view class="stat-num">{{newCount}}</view>
            <view class="stat-label">待新学</view>
          </view>
          <view class="stat">
            <view class="studs sm"><view class="pt"></view><view class="pt"></view></view>
            <view class="stat-num stat-num-sm">{{estimateText || '—'}}</view>
            <view class="stat-label">预计分钟</view>
          </view>
        </view>

        <button
          hover-class="btn-press" class="btn btn-primary task-btn"
          bindtap="startStudy"
          disabled="{{reviewCount + newCount === 0}}">
          {{reviewCount + newCount === 0 ? '今天没有要学的了' : '⚡ 开始学习'}}
        </button>
      </block>

    </block>

    <block wx:else>
      <view class="empty">
        <view class="empty-text">还没有选择教材\n先去词库挑选要背的课本</view>
        <button hover-class="btn-press" class="btn btn-primary btn-sm" bindtap="startStudy">去选教材</button>
      </view>
    </block>
  </view>

  <!-- ===== 最近 7 天 ===== -->
  <view class="card plate offset" wx:if="{{hasShelf}}" bindtap="goRecords">
    <view class="studs">
      <view class="pt"></view><view class="pt"></view>
      <view class="pt"></view><view class="pt"></view>
    </view>
    <view class="sec-head">
      <text class="sec-title">最近 7 天</text>
      <text class="sec-link">查看记录 ›</text>
    </view>
    <view class="days">
      <view class="day" wx:for="{{recentDays}}" wx:key="date">
        <view class="day-dot {{item.finished ? 'day-on' : (item.newCount + item.reviewCount > 0 ? 'day-half' : '')}}">
          <text class="day-star" wx:if="{{item.finished}}">★</text>
        </view>
        <text class="day-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 主学教材 ===== -->
  <view class="card plate" wx:if="{{primaryBook}}" bindtap="goBookshelf">
    <view class="studs">
      <view class="pt"></view><view class="pt"></view>
      <view class="pt"></view><view class="pt"></view>
    </view>
    <view class="sec-head">
      <text class="sec-title">主学教材</text>
      <text class="sec-link">管理 ›</text>
    </view>
    <view class="book-row">
      <view class="book-cover">
        <view class="book-cover-lines"></view>
      </view>
      <view class="book-info">
        <view class="book-name">{{primaryBook.name}}</view>
        <view class="book-meta">{{primaryBook.learned}} / {{primaryBook.total}} 词已学 · 还差 {{primaryBook.total - primaryBook.learned}} 个</view>
        <view class="bar book-bar">
          <view class="bar-fill" style="width: {{primaryBook.percent}}%"></view>
        </view>
      </view>
      <view class="pctb sticker">{{primaryBook.percent}}%</view>
    </view>
  </view>

  <!-- ===== 学习总览 ===== -->
  <view class="card plate offset">
    <view class="studs">
      <view class="pt"></view><view class="pt"></view>
      <view class="pt"></view><view class="pt"></view>
    </view>
    <view class="sec-head"><text class="sec-title">学习总览</text></view>
    <view class="stat-grid">
      <view class="stat">
        <view class="studs sm"><view class="pt"></view><view class="pt"></view></view>
        <view class="stat-num">{{overall.learned}}</view>
        <view class="stat-label">已学单词</view>
      </view>
      <view class="stat">
        <view class="studs sm"><view class="pt"></view><view class="pt"></view></view>
        <view class="stat-num">{{overall.mastered}}</view>
        <view class="stat-label">已掌握</view>
      </view>
      <view class="stat">
        <view class="studs sm"><view class="pt"></view><view class="pt"></view></view>
        <view class="stat-num">{{overall.totalLibrary}}</view>
        <view class="stat-label">词库总量</view>
      </view>
    </view>
  </view>

  <!-- ===== 快捷入口 ===== -->
  <view class="card plate">
    <view class="studs">
      <view class="pt"></view><view class="pt"></view>
      <view class="pt"></view><view class="pt"></view>
    </view>
    <view class="list-item" bindtap="goPlan">
      <view class="li-left">
        <view class="li-ic ic-yellow">计</view>
        <text class="li-title">学习计划</text>
      </view>
      <text class="li-right">每日新词 {{plan.dailyNewCount}} 个 ›</text>
    </view>
    <view class="list-item" bindtap="goWrongBook">
      <view class="li-left">
        <view class="li-ic ic-red">错</view>
        <text class="li-title">错词本</text>
      </view>
      <text class="li-right">重点复习的词 ›</text>
    </view>
  </view>

</view>
