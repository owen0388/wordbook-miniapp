/* 首页 */

.hero {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(120% 140% at 0% 0%, #40569C 0%, rgba(64, 86, 156, 0) 56%),
    linear-gradient(158deg, #2D4079 0%, #19264D 100%);
  border-radius: var(--r-lg);
  padding: 40rpx 36rpx 36rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 20rpx 44rpx -22rpx rgba(25, 38, 77, 0.8);
}

/* 装饰光环：头部的深色块需要一点空间层次，否则像一块色板 */
.hero::after {
  content: '';
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  right: -100rpx;
  top: -160rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 0 0 36rpx rgba(255, 255, 255, 0.045), 0 0 0 78rpx rgba(255, 255, 255, 0.028);
  pointer-events: none;
}


/* 深色区撒一层星点：浅底上看不见，深底上才成为"空气感" */
.hero::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  background-image:
    radial-gradient(circle, rgba(255, 255, 255, 0.9) 0 2rpx, transparent 3rpx),
    radial-gradient(circle, rgba(255, 255, 255, 0.5) 0 1rpx, transparent 2rpx);
  background-size: 132rpx 132rpx, 80rpx 80rpx;
  background-position: 0 0, 40rpx 56rpx;
  opacity: 0.3;
}

.hero .mascot {
  margin: 0 10rpx 0 18rpx;
}

.hero-date {
  position: relative;
  font-size: 24rpx;
  opacity: 0.72;
  margin-bottom: 10rpx;
  letter-spacing: 0.06em;
}

.hero-title {
  position: relative;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.streak {
  position: relative;
  text-align: center;
  min-width: 130rpx;
}

.streak-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.streak-label {
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 4rpx;
}

.task-card {
  margin-top: -12rpx;
}

.task-btn {
  margin-top: 32rpx;
}

.task-hint {
  margin-top: 20rpx;
}

.book-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.book-meta {
  margin-bottom: 16rpx;
}

.book-bar {
  margin-top: 4rpx;
}
