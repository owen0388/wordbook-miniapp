/* ============ 我的教材 · 积木世界 ============ */

.plate {
  margin-top: 40rpx;
  margin-bottom: 32rpx;
  padding: 32rpx 6.5% 6.5%;
}

.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.sec-title { font-size: 29rpx; font-weight: 900; color: var(--ink); }
.sec-link { font-size: 22rpx; font-weight: 800; color: var(--accent-deep); }

.book {
  padding: 26rpx 0;
  border-bottom: 3rpx dashed var(--dash);
}
.book:last-of-type { border-bottom: none; }

.book-head { margin-bottom: 6rpx; }
.book-name {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1.35;
}
.book-meta {
  font-size: 21rpx;
  color: var(--ink-mute);
}
.book-stat { margin: 18rpx 0 12rpx; }
.book-prog-text { font-size: 21rpx; color: var(--ink-3); }
.book-pct {
  font-size: 23rpx;
  font-weight: 900;
  color: var(--accent-deep);
  font-variant-numeric: tabular-nums;
}

/* 操作行：小米白积木 */
.ops {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}
.op {
  font-size: 23rpx;
  font-weight: 900;
  color: var(--ink-2);
  padding: 10rpx 24rpx;
  border-radius: 18rpx / 34%;
  background-image: linear-gradient(180deg, var(--cream-ft) 0 26%, var(--cream-fb) 58%, var(--cream-fb2) 100%);
  box-shadow: 0 0 0 5rpx var(--cream-e), 0 5rpx 0 var(--cream-sd);
}
.op:active { transform: translateY(4rpx); box-shadow: 0 0 0 5rpx var(--cream-e), 0 1rpx 0 var(--cream-sd); }
.op-danger {
  color: #A5321A;
  background-image: linear-gradient(180deg, #FFE2CE 0 26%, #FFD5C0 58%, #F8C6AE 100%);
  box-shadow: 0 0 0 5rpx rgba(150,40,20,.8), 0 5rpx 0 #C4785C;
}
.op-danger:active { transform: translateY(4rpx); box-shadow: 0 0 0 5rpx rgba(150,40,20,.8), 0 1rpx 0 #C4785C; }
