/* 词库检索 */

.search {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 44rpx;
  padding: 0 32rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 58, 107, 0.05);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 88rpx;
}

.search-clear {
  font-size: 26rpx;
  color: var(--muted);
  padding-left: 20rpx;
}

.filter-label {
  font-size: 24rpx;
  color: var(--muted);
  margin: 24rpx 0 16rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: var(--bg);
  color: var(--text-sub);
  border: 1rpx solid transparent;
}

.chip-on {
  background: var(--primary-soft);
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
}

/* 教材条目 */
.book {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.book:last-child {
  border-bottom: none;
}

.book-main {
  flex: 1;
  padding-right: 20rpx;
}

.book-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.book-meta {
  font-size: 24rpx;
}

.book-bar {
  margin-top: 20rpx;
}

.book-progress {
  margin-top: 12rpx;
}

/* 搜索结果 */
.sr {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.sr:last-child {
  border-bottom: none;
}

.sr-left {
  width: 240rpx;
  flex-shrink: 0;
}

.sr-word {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
}

.sr-phonetic {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.sr-right {
  flex: 1;
}

.sr-meaning {
  font-size: 28rpx;
}

.sr-book {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.version {
  margin-top: 20rpx;
}
