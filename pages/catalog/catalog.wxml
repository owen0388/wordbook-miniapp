<view class="page-in page">

  <view class="fx-glow"></view>
  <view class="fx-bg"></view>

  <!-- 搜索：做成"凹槽"，面板比斜面亮，暗示往里填 -->
  <view class="search">
    <text class="search-ico">🔍</text>
    <input
      class="search-input"
      value="{{keyword}}"
      bindinput="onKeyword"
      placeholder="搜一个单词，比如 apple"
      confirm-type="search" />
    <view class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">×</view>
  </view>

  <!-- 搜索结果 -->
  <block wx:if="{{searching}}">
    <view class="card plate">
      <view class="studs">
        <view class="pt"></view><view class="pt"></view>
        <view class="pt"></view><view class="pt"></view>
      </view>
      <view class="sec-head">
        <text class="sec-title">搜索结果</text>
        <text class="sec-link">{{searchResults.length}} 条</text>
      </view>
      <view class="sr" wx:for="{{searchResults}}" wx:key="id">
        <view class="sr-left">
          <view class="sr-word">{{item.word}}</view>
          <view class="sr-phonetic">{{item.phonetic}}</view>
        </view>
        <view class="sr-right">
          <view class="sr-meaning">{{item.pos}} {{item.meaningCn}}</view>
          <view class="sr-book">{{item.textbookName}}</view>
        </view>
      </view>
      <view class="empty" wx:if="{{searchResults.length === 0}}">
        <view class="empty-text">没有找到匹配的词</view>
      </view>
    </view>
  </block>

  <!-- 筛选 + 教材列表 -->
  <block wx:else>
    <view class="card plate">
      <view class="studs">
        <view class="pt"></view><view class="pt"></view>
        <view class="pt"></view><view class="pt"></view>
      </view>
      <view class="sec-head">
        <text class="sec-title">筛选教材</text>
        <text class="sec-link" bindtap="resetFilter">重置</text>
      </view>

      <view class="filter-label">教材版本</view>
      <view class="chips">
        <view
          class="chip {{filter.publisher === item ? 'chip-on' : ''}}"
          wx:for="{{publishers}}"
          wx:key="*this"
          data-value="{{item}}"
          bindtap="pickPublisher">{{item}}</view>
      </view>

      <view class="filter-label">年级</view>
      <view class="chips">
        <view
          class="chip {{String(filter.grade) === String(item) ? 'chip-on' : ''}}"
          wx:for="{{grades}}"
          wx:key="*this"
          data-value="{{item}}"
          bindtap="pickGrade">{{item}} 年级</view>
      </view>

      <view class="filter-label">学期</view>
      <view class="chips">
        <view
          class="chip {{filter.term === item ? 'chip-on' : ''}}"
          wx:for="{{terms}}"
          wx:key="*this"
          data-value="{{item}}"
          bindtap="pickTerm">{{item}}册</view>
      </view>
    </view>

    <view class="card plate offset">
      <view class="studs">
        <view class="pt"></view><view class="pt"></view>
        <view class="pt"></view><view class="pt"></view>
      </view>
      <view class="sec-head">
        <text class="sec-title">教材列表</text>
        <text class="sec-link">共 {{textbooks.length}} 本</text>
      </view>

      <view class="book" wx:for="{{textbooks}}" wx:key="id">
        <view class="row-between">
          <view class="book-main" data-id="{{item.id}}" bindtap="goDetail">
            <view class="book-name">{{item.name}}</view>
            <view class="book-meta">{{item.unitCount}} 单元 · {{item.wordCount}} 词 · {{item.publisher}}</view>
          </view>
          <button
            hover-class="btn-press" class="btn btn-sm {{item.inShelf ? 'btn-ghost' : 'btn-accent'}}"
            data-id="{{item.id}}"
            bindtap="addToShelf"
            disabled="{{item.inShelf}}">{{item.inShelf ? '已加入' : '加入书架'}}</button>
        </view>
        <view class="bar book-bar" wx:if="{{item.inShelf}}">
          <view class="bar-fill" style="width: {{item.percent}}%"></view>
        </view>
        <view class="book-progress" wx:if="{{item.inShelf}}">
          已学 {{item.learned}} / {{item.total}} 词（{{item.percent}}%）
        </view>
      </view>

      <view class="empty" wx:if="{{textbooks.length === 0}}">
        <view class="empty-text">当前筛选条件下没有教材</view>
      </view>
    </view>

    <view class="version">词库版本 {{dictVersion}}</view>
  </block>

</view>
