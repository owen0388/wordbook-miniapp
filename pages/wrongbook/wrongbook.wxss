/* 错词本 */

.mb { margin-bottom: 28rpx; }

.wb {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.wb:last-child {
  border-bottom: none;
}

.wb-main {
  flex: 1;
  padding-right: 20rpx;
}

.wb-word {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary);
}

.wb-phonetic {
  font-size: 24rpx;
  color: var(--muted);
}

.wb-meaning {
  font-size: 28rpx;
  margin-top: 8rpx;
}

.wb-meta {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.wb-op {
  font-size: 24rpx;
  color: var(--muted);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 10rpx 26rpx;
  flex-shrink: 0;
}
