/* ============ 错词本 · 积木世界 ============ */

.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.sec-title { font-size: 29rpx; font-weight: 900; color: var(--ink); }
.sec-link { font-size: 22rpx; font-weight: 800; color: var(--accent-deep); }

.mb { margin-bottom: 24rpx; }
.wb-start { width: 100%; transform: rotate(-.6deg); }
.wb-start.btn-press { transform: rotate(-.6deg) translateY(6rpx) scale(.992); }

.wb {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 3rpx dashed var(--dash);
}
.wb:last-child { border-bottom: none; }

.wb-main { flex: 1; padding-right: 18rpx; min-width: 0; }
.wb-head { margin-bottom: 4rpx; }
.wb-word {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--ink);
  word-break: break-all;
}
.wb-phonetic { font-size: 21rpx; color: var(--ink-mute); }
.wb-meaning {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--ink-2);
  margin-top: 4rpx;
  line-height: 1.5;
}
.wb-meta { font-size: 20rpx; color: var(--ink-mute); margin-top: 6rpx; }

/* 移除：小号米白积木 */
.wb-op {
  flex: none;
  font-size: 22rpx;
  font-weight: 900;
  color: var(--ink-3);
  padding: 9rpx 22rpx;
  border-radius: 16rpx / 34%;
  background-image: linear-gradient(180deg, var(--cream-ft) 0 26%, var(--cream-fb) 58%, var(--cream-fb2) 100%);
  box-shadow: 0 0 0 5rpx var(--cream-e), 0 5rpx 0 var(--cream-sd);
}
.wb-op:active { transform: translateY(4rpx); box-shadow: 0 0 0 5rpx var(--cream-e), 0 1rpx 0 var(--cream-sd); }
