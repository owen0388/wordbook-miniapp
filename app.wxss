/* ===================== 字体 =====================
 * Baloo 2 ExtraBold：圆润、宽厚，接近儿童绘本标题字。
 * 只含拉丁字母（约 23KB base64），中文回落到系统字体——
 * 中文字库动辄几 MB，塞进主包会直接撞上 2MB 上限。
 * 效果上英文单词、数字、按钮文案都是圆胖体，中文保持系统字重，混排层次更清楚。
 *
 * 字体本身放在 assets/font.wxss：那是一条约 23KB 的超长单行，
 * 混在本文件里，任何一次整体重写都有把它截断的风险（踩过一次，编译报
 * unexpected token）。独立成文件后，改样式不用再碰它。
 */
@import "assets/font.wxss";

/* ===================== 设计令牌：积木世界 =====================
 * 一套色 = 6 个变量（正面板 c / 斜面亮 ft / 斜面 fb / 斜面暗 fb2 / 厚度 sd / 描边 e）。
 * 换色只换变量，不动结构。页面里通过 style="--c:var(--red-c);..." 或
 * class="brick red" 切换。
 */
page {
  --red-c:#F23A23;    --red-ft:#FEC298;  --red-fb:#FEA475;  --red-fb2:#FE9A6B;  --red-sd:#B23A1E;  --red-e:rgba(110,24,10,.92);
  --blue-c:#2F8FE0;   --blue-ft:#BFE4FB; --blue-fb:#6FBAF0; --blue-fb2:#4EA3E4; --blue-sd:#1864AC; --blue-e:rgba(8,48,96,.92);
  --yellow-c:#F5B722; --yellow-ft:#FFE9A6;--yellow-fb:#FFD46E;--yellow-fb2:#F7C246;--yellow-sd:#C78D12;--yellow-e:rgba(118,66,8,.92);
  --green-c:#43B24A;  --green-ft:#C9EDBF;--green-fb:#7FD46E; --green-fb2:#57BE52;--green-sd:#2F8C36; --green-e:rgba(12,62,18,.92);
  --purple-c:#8E55D0; --purple-ft:#DEC7F7;--purple-fb:#B887EC;--purple-fb2:#9A66DC;--purple-sd:#5F35A0;--purple-e:rgba(40,18,80,.92);
  --orange-c:#F58220; --orange-ft:#FFD3A2;--orange-fb:#FEA860;--orange-fb2:#F58F3C;--orange-sd:#C46A1E;--orange-e:rgba(122,60,8,.92);
  --cream-c:#EFD9B4;  --cream-ft:#FFF8E9;--cream-fb:#F3DCB6; --cream-fb2:#E8CFA4;--cream-sd:#C79A64;--cream-e:rgba(140,88,20,.85);
  --brown-c:#B0703C;  --brown-ft:#E8C49A;--brown-fb:#CC9462; --brown-fb2:#B77C48;--brown-sd:#7A4A22;--brown-e:rgba(74,40,12,.92);

  /* 文字与辅助 */
  --ink: #4A3524;             /* 主文字：深棕，不用纯黑 */
  --ink-2: #7A5732;
  --ink-3: #8A6A48;
  --ink-mute: #A98A62;
  --ink-mute-2: #9A7A54;
  --accent-hot: #F2603C;
  --accent-deep: #C0563C;
  --btn-yellow-num: #FFE07A;
  --dash: rgba(140,85,10,.22);
  --desk: #EFD9B4;            /* 木桌面 / 页面底 */
  --screen: #F7E7CB;          /* 手机屏底 */

  /* 语义色，沿用旧名以免页面里的引用失效 */
  --primary: #4A3524;
  --primary-soft: #F3DCB6;
  --accent: #F2603C;
  --accent-ink: #4A1608;
  --accent-soft: #FFE3D3;
  --bg: #EFD9B4;
  --card: #EFD9B4;
  --text: #4A3524;
  --text-sub: #7A5732;
  --muted: #8A6A48;
  --line: #C79A64;
  --line-soft: #E8CFA4;
  --success: #2F8C36;
  --success-soft: #C9EDBF;
  --warn: #B58322;
  --warn-soft: #FFE9A6;
  --danger: #B23A1E;
  --danger-soft: #FFD5C0;

  --glow-coral: rgba(242,96,60,.4);
  --glow-indigo: rgba(47,143,224,.3);
  --glow-mint: rgba(67,178,74,.28);

  --r-lg: 38rpx;
  --r-md: 28rpx;
  --r-pill: 999rpx;
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --font-display: 'WBDisplay', 'Yuanti SC', 'YouYuan', '幼圆', 'PingFang SC',
                  'Microsoft YaHei UI Rounded', 'Microsoft YaHei', system-ui, sans-serif;

  background-color: #EFD9B4;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 26rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* ===================== 木桌面底纹 =====================
 * 纯 CSS：横向细木纹 + 两团暖色斑。不用图片，不占包体积。
 * 旧的 .fx-bg / .fx-glow 保留为空壳，页面 WXML 不需要改。
 */
.fx-bg,
.fx-glow {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: -1;
  pointer-events: none;
}
.fx-bg {
  background-color: var(--desk);
  background-image:
    repeating-linear-gradient(180deg,
      rgba(150,100,40,.055) 0 1rpx, transparent 1rpx 14rpx),
    repeating-linear-gradient(90deg,
      rgba(150,100,40,.03) 0 2rpx, transparent 2rpx 190rpx);
}
.fx-glow {
  background-image:
    radial-gradient(460rpx 460rpx at 6% 2%, rgba(255,236,196,.5), transparent 70%),
    radial-gradient(560rpx 560rpx at 104% 18%, rgba(206,160,96,.28), transparent 72%),
    radial-gradient(700rpx 700rpx at 40% 106%, rgba(178,120,52,.22), transparent 74%);
}

.page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}
/* 手机屏底：首页那层略亮的纸 */
.page-screen {
  background: var(--screen);
  border-radius: 44rpx 44rpx 0 0;
}

/* ===================== 贴纸字 =====================
 * 规格书用 -webkit-text-stroke + paint-order，部分安卓 WebView 不支持
 * paint-order，描边会压在字上面把字变细。这里统一用 8 方向 text-shadow 模拟，
 * 全平台一致、零兼容风险，粗描边下视觉差别很小。
 */
.sticker {
  color: #fff;
  text-shadow:
    -1.5rpx -1.5rpx 0 var(--sk, #6B2408),  1.5rpx -1.5rpx 0 var(--sk, #6B2408),
    -1.5rpx  1.5rpx 0 var(--sk, #6B2408),  1.5rpx  1.5rpx 0 var(--sk, #6B2408),
     0      -1.5rpx 0 var(--sk, #6B2408),  0       1.5rpx 0 var(--sk, #6B2408),
    -1.5rpx  0     0 var(--sk, #6B2408),  1.5rpx  0     0 var(--sk, #6B2408),
     1rpx    2rpx  0 rgba(110,24,10,.55);
}
.sticker-lg { text-shadow:
    -2rpx -2rpx 0 var(--sk, #6B2408),  2rpx -2rpx 0 var(--sk, #6B2408),
    -2rpx  2rpx 0 var(--sk, #6B2408),  2rpx  2rpx 0 var(--sk, #6B2408),
     0    -2rpx 0 var(--sk, #6B2408),  0     2rpx 0 var(--sk, #6B2408),
    -2rpx  0    0 var(--sk, #6B2408),  2rpx  0    0 var(--sk, #6B2408),
     1rpx  3rpx 0 rgba(110,24,10,.5); }
.sticker-yellow { color: var(--btn-yellow-num); }
/* 米白积木上的字：深棕，不描边 */
.on-cream { color: var(--ink); text-shadow: none; }

/* ===================== 积木基类 =====================
 * 三层：斜面外壳（自身） + 内嵌正面板（::before） + 顶部凸点（.studs）
 * 宽度/高度全用 rpx（设计稿 390px × 1.923 = 750rpx 体系），
 * 不用 clamp：rpx 本身已按屏宽等比缩放，再套 clamp 反而在部分安卓 WebView 上失效。
 */
.brick {
  position: relative;
  padding: 35rpx 6.5% 6.5%;
  border-radius: 38rpx / 14%;
  background-image: linear-gradient(180deg, var(--ft) 0 22%, var(--fb) 55%, var(--fb2) 100%);
  box-shadow:
    0 0 0 7rpx var(--e),
    0 10rpx 0 var(--sd),
    0 10rpx 19rpx rgba(60,25,8,.3),
    0 25rpx 38rpx -19rpx rgba(60,25,8,.42);
}
.brick::before {
  content: "";
  position: absolute;
  z-index: 1;
  left: 5.5%; right: 5.5%;
  top: 25rpx; bottom: 5.5%;
  border-radius: 0 0 17rpx 17rpx / 0 0 12% 12%;
  background: var(--c);
  box-shadow: inset 0 0 0 3rpx var(--e);
  pointer-events: none;
}
/* 正面板是 ::before，文字必须抬到面板之上；凸点要留在 absolute 层 */
.brick > view,
.brick > text,
.brick > button,
.brick > input,
.brick > scroll-view { position: relative; z-index: 2; }
.brick > .studs { position: absolute; z-index: 3; }

/* ===================== 凸点 ===================== */
.studs {
  position: absolute;
  top: -23rpx; left: 16%; right: 16%;
  height: 23rpx;
  display: flex;
  gap: 12%;
  justify-content: space-between;
  z-index: 3;
  pointer-events: none;
}
.studs .pt {
  flex: 1 1 0;
  min-width: 0;
  position: relative;
  border-radius: 50% / 30%;
  background-image: linear-gradient(180deg,
    var(--ft) 0%, var(--ft) 40%,
    var(--fb) 48%,
    var(--fb2) 100%);
  box-shadow: 0 0 0 6rpx var(--e), 0 6rpx 10rpx rgba(60,25,8,.28);
}
/* 中央凹孔：没有这个就不像乐高 */
.studs .pt::before {
  content: "";
  position: absolute;
  left: 21%; right: 21%; top: 8%; height: 24%;
  border-radius: 50%;
  background: var(--e);
}
/* 小号凸点：小尺寸要放大凹孔才看得见 */
.studs.sm { top: -17rpx; height: 19rpx; left: 20%; right: 20%; gap: 24%; }
.studs.sm .pt { box-shadow: 0 0 0 4rpx var(--e), 0 4rpx 7rpx rgba(60,25,8,.26); }
.studs.sm .pt::before { left: 26%; right: 26%; top: 10%; height: 32%; }
/* 细条凸点（日期条用） */
.studs.thin { top: -17rpx; height: 17rpx; left: 8%; right: 8%; gap: 6%; }
.studs.thin .pt { box-shadow: 0 0 0 4rpx var(--e), 0 3rpx 5rpx rgba(60,25,8,.24); }
/* 大号凸点（hero 用） */
.studs.lg { top: -46rpx; height: 46rpx; left: 20%; right: 20%; gap: 12%; }

/* ===================== B 类按钮：三层 background-clip =====================
 * ② 层不透明且只画在 padding-box，正好遮住 ③ 层在内侧的部分，
 * 于是 border 区露出 ③ 层的斜面 → 内嵌效果。border-radius 自动给两层分别裁角。
 * 比伪元素方案好：文字永远在最上层，不会被面板遮。
 */
.btn-brick {
  position: relative;
  border: 10rpx solid transparent;
  border-radius: 29rpx / 30%;
  background-color: var(--c);
  background-image:
    linear-gradient(180deg, rgba(255,255,255,.18), rgba(255,255,255,0) 42%, rgba(0,0,0,.05)),
    linear-gradient(180deg, var(--c), var(--c)),
    linear-gradient(180deg, var(--ft) 0 24%, var(--fb) 56%, var(--fb2) 100%);
  background-clip: padding-box, padding-box, border-box;
  background-origin: padding-box, padding-box, border-box;
  box-shadow:
    inset 0 0 0 3rpx rgba(70,35,10,.2),
    0 0 0 6rpx var(--e),
    0 8rpx 0 var(--sd),
    0 10rpx 19rpx rgba(60,25,8,.28),
    0 25rpx 38rpx -19rpx rgba(60,25,8,.4);
}
/* 按钮按压：必须保留 rotate，否则积木会瞬间摆正，破坏"摆歪"的整体感 */
.btn-brick-press {
  transform: translateY(6rpx) scale(.992);
  filter: brightness(.97);
}

/* ===================== 兼容层：把旧类名映射到积木 =====================
 * 页面 WXML 沿用 .card / .btn / .tag / .stat 等旧类名，
 * 这样换肤不用重写每个页面的结构，只需补 .studs 凸点。
 */

/* --- .card → plate 内容卡片 --- */
.card {
  position: relative;
  margin-top: 26rpx;
  margin-bottom: 26rpx;
  padding: 35rpx 6.5% 6.5%;
  border-radius: 38rpx / 14%;
  --c: var(--cream-c); --ft: var(--cream-ft); --fb: var(--cream-fb);
  --fb2: var(--cream-fb2); --sd: var(--cream-sd); --e: var(--cream-e);
  background-image: linear-gradient(180deg, var(--ft) 0 22%, var(--fb) 55%, var(--fb2) 100%);
  box-shadow:
    0 0 0 7rpx var(--e),
    0 10rpx 0 var(--sd),
    0 10rpx 19rpx rgba(60,25,8,.28),
    0 25rpx 38rpx -19rpx rgba(60,25,8,.4);
  overflow: visible;
}
.card::before {
  content: "";
  position: absolute;
  z-index: 1;
  left: 5.5%; right: 5.5%;
  top: 25rpx; bottom: 5.5%;
  border-radius: 0 0 17rpx 17rpx / 0 0 12% 12%;
  background: var(--c);
  box-shadow: inset 0 0 0 3rpx var(--e);
  pointer-events: none;
}
.card > view,
.card > text,
.card > button,
.card > input,
.card > scroll-view { position: relative; z-index: 2; }
.card > .studs { position: absolute; z-index: 3; }

/* 卡片错位：交替轻移，制造"手放在桌上"的不齐感 */
.card.offset { margin-left: 13rpx; margin-right: -6rpx; transform: rotate(.6deg); }

.card-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ink);
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* --- 彩色卡片变体 --- */
.card-red    { --c: var(--red-c);    --ft: var(--red-ft);    --fb: var(--red-fb);    --fb2: var(--red-fb2);    --sd: var(--red-sd);    --e: var(--red-e); }
.card-blue   { --c: var(--blue-c);   --ft: var(--blue-ft);   --fb: var(--blue-fb);   --fb2: var(--blue-fb2);   --sd: var(--blue-sd);   --e: var(--blue-e); }
.card-yellow { --c: var(--yellow-c); --ft: var(--yellow-ft); --fb: var(--yellow-fb); --fb2: var(--yellow-fb2); --sd: var(--yellow-sd); --e: var(--yellow-e); }
.card-green  { --c: var(--green-c);  --ft: var(--green-ft);  --fb: var(--green-fb);  --fb2: var(--green-fb2);  --sd: var(--green-sd);  --e: var(--green-e); }
.card-purple { --c: var(--purple-c); --ft: var(--purple-ft); --fb: var(--purple-fb); --fb2: var(--purple-fb2); --sd: var(--purple-sd); --e: var(--purple-e); }

/* --- .btn → 积木按钮 --- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border: 10rpx solid transparent;
  border-radius: 29rpx / 28%;
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1;
  --c: var(--red-c); --ft: var(--red-ft); --fb: var(--red-fb);
  --fb2: var(--red-fb2); --sd: var(--red-sd); --e: var(--red-e);
  background-color: var(--c);
  background-image:
    linear-gradient(180deg, rgba(255,255,255,.18), rgba(255,255,255,0) 42%, rgba(0,0,0,.05)),
    linear-gradient(180deg, var(--c), var(--c)),
    linear-gradient(180deg, var(--ft) 0 24%, var(--fb) 56%, var(--fb2) 100%);
  background-clip: padding-box, padding-box, border-box;
  background-origin: padding-box, padding-box, border-box;
  box-shadow:
    inset 0 0 0 3rpx rgba(70,35,10,.2),
    0 0 0 6rpx var(--e),
    0 8rpx 0 var(--sd),
    0 10rpx 19rpx rgba(60,25,8,.28),
    0 25rpx 38rpx -19rpx rgba(60,25,8,.4);
  color: #fff;
  --sk: #6B2408;
  text-shadow:
    -1.5rpx -1.5rpx 0 var(--sk),  1.5rpx -1.5rpx 0 var(--sk),
    -1.5rpx  1.5rpx 0 var(--sk),  1.5rpx  1.5rpx 0 var(--sk),
     0      -1.5rpx 0 var(--sk),  0       1.5rpx 0 var(--sk),
    -1.5rpx  0     0 var(--sk),  1.5rpx  0     0 var(--sk);
}
.btn::after { border: none; }
.btn:active {
  transform: translateY(7rpx);
  box-shadow: inset 0 0 0 3rpx rgba(70,35,10,.2), 0 0 0 6rpx var(--e), 0 3rpx 0 var(--sd), 0 5rpx 10rpx -6rpx rgba(90,30,10,.5);
}

/* 主按钮：红（与原 .btn-primary 语义一致） */
.btn-primary { }
.btn-primary:active {
  transform: translateY(7rpx);
  box-shadow: inset 0 0 0 3rpx rgba(70,35,10,.2), 0 0 0 6rpx var(--red-e), 0 3rpx 0 var(--red-sd), 0 5rpx 10rpx -6rpx rgba(90,30,10,.5);
}

/* 次按钮：蓝。答错后的"下一题"用它，比红色冷静 */
.btn-accent {
  --c: var(--blue-c); --ft: var(--blue-ft); --fb: var(--blue-fb);
  --fb2: var(--blue-fb2); --sd: var(--blue-sd); --e: var(--blue-e);
  --sk: #062A52;
}
.btn-accent:active {
  transform: translateY(7rpx);
  box-shadow: inset 0 0 0 3rpx rgba(70,35,10,.2), 0 0 0 6rpx var(--blue-e), 0 3rpx 0 var(--blue-sd), 0 5rpx 10rpx -6rpx rgba(10,30,70,.5);
}

/* 幽灵按钮：米白积木，深棕字不描边 */
.btn-ghost {
  --c: var(--cream-c); --ft: var(--cream-ft); --fb: var(--cream-fb);
  --fb2: var(--cream-fb2); --sd: var(--cream-sd); --e: var(--cream-e);
  color: var(--ink);
  text-shadow: none;
}
.btn-ghost:active {
  transform: translateY(6rpx);
  box-shadow: inset 0 0 0 3rpx rgba(70,35,10,.18), 0 0 0 6rpx var(--cream-e), 0 3rpx 0 var(--cream-sd), 0 5rpx 10rpx -6rpx rgba(90,60,20,.35);
}

/* 危险按钮：棕红，仅用于"清除数据"这类操作 */
.btn-danger-ghost {
  --c: #FFF1E8; --ft: #FFE2CE; --fb: #FFD5C0; --fb2: #F8C6AE;
  --sd: #C4785C; --e: rgba(150,40,20,.85);
  color: #A5321A;
  text-shadow: none;
}
.btn-danger-ghost:active {
  transform: translateY(6rpx);
  box-shadow: inset 0 0 0 3rpx rgba(150,40,20,.2), 0 0 0 6rpx rgba(150,40,20,.85), 0 2rpx 0 #C4785C;
}

.btn-sm { height: 78rpx; font-size: 27rpx; padding: 0 30rpx; border-width: 8rpx; }

/* 禁用：抽掉斜面和厚度，看起来"沉进桌面"，不再像可点的积木 */
.btn[disabled] {
  --c: #E3D3B6; --ft: #F0E3CB; --fb: #E3D3B6; --fb2: #D6C3A2;
  --sd: #BCA582; --e: rgba(140,110,70,.6);
  color: #A08E70;
  text-shadow: none;
  box-shadow: inset 0 0 0 3rpx rgba(140,110,70,.25), 0 0 0 6rpx rgba(140,110,70,.6), 0 3rpx 0 #BCA582;
  opacity: 1;
  transform: none;
}

/* 真机上 :active 对自定义按钮不可靠，按压感统一交给 hover-class */
.btn-press { transform: translateY(7rpx); filter: brightness(.97); }
.btn-press.btn-primary,
.btn-press.btn-accent {
  box-shadow: inset 0 0 0 3rpx rgba(70,35,10,.2), 0 0 0 6rpx var(--e), 0 3rpx 0 var(--sd), 0 5rpx 10rpx -6rpx rgba(90,30,10,.5);
}
.btn-press.btn-ghost {
  box-shadow: inset 0 0 0 3rpx rgba(70,35,10,.18), 0 0 0 6rpx var(--cream-e), 0 3rpx 0 var(--cream-sd);
}
.btn-press.btn-danger-ghost {
  box-shadow: inset 0 0 0 3rpx rgba(150,40,20,.2), 0 0 0 6rpx rgba(150,40,20,.85), 0 2rpx 0 #C4785C;
}

/* --- .tag → 小号 chip --- */
.tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 900;
  padding: 5rpx 18rpx;
  border-radius: 20rpx / 34%;
  background: var(--red-c);
  color: #fff;
  line-height: 1.6;
  --sk: #6B2408;
  text-shadow: -1rpx -1rpx 0 var(--sk), 1rpx -1rpx 0 var(--sk), -1rpx 1rpx 0 var(--sk), 1rpx 1rpx 0 var(--sk);
  box-shadow: 0 0 0 5rpx var(--red-e), 0 5rpx 0 var(--red-sd);
}
.tag-primary { background: var(--blue-c); box-shadow: 0 0 0 5rpx var(--blue-e), 0 5rpx 0 var(--blue-sd); --sk: #062A52; }
.tag-success { background: var(--green-c); box-shadow: 0 0 0 5rpx var(--green-e), 0 5rpx 0 var(--green-sd); --sk: #0A3A10; }
.tag-warn {
  background: var(--yellow-c); color: var(--ink); text-shadow: none;
  box-shadow: 0 0 0 5rpx var(--yellow-e), 0 5rpx 0 var(--yellow-sd);
}

/* --- .stat → st 小积木 --- */
.stat-grid { display: flex; gap: 18rpx; }
.stat {
  flex: 1;
  position: relative;
  padding: 22rpx 8rpx 18rpx;
  border-radius: 30rpx / 16%;
  text-align: center;
  --c: var(--red-c); --ft: var(--red-ft); --fb: var(--red-fb);
  --fb2: var(--red-fb2); --sd: var(--red-sd); --e: var(--red-e);
  background-image: linear-gradient(180deg, var(--ft) 0 22%, var(--fb) 55%, var(--fb2) 100%);
  box-shadow: 0 0 0 6rpx var(--e), 0 7rpx 0 var(--sd), 0 10rpx 16rpx -10rpx rgba(60,25,8,.5);
}
.stat::before {
  content: "";
  position: absolute;
  z-index: 1;
  left: 5.5%; right: 5.5%; top: 15rpx; bottom: 5.5%;
  border-radius: 0 0 13rpx 13rpx / 0 0 12% 12%;
  background: var(--c);
  box-shadow: inset 0 0 0 3rpx var(--e);
  pointer-events: none;
}
.stat > view, .stat > text { position: relative; z-index: 2; }
/* 凸点必须留在绝对定位层，否则会被上面那条规则拉回文档流 */
.stat > .studs { position: absolute; z-index: 3; }
.stat-num {
  font-family: var(--font-display);
  font-size: 46rpx;
  font-weight: 900;
  color: #fff;
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
  --sk: #6B2408;
  text-shadow: -1.5rpx -1.5rpx 0 var(--sk), 1.5rpx -1.5rpx 0 var(--sk), -1.5rpx 1.5rpx 0 var(--sk), 1.5rpx 1.5rpx 0 var(--sk), 0 3rpx 0 rgba(110,24,10,.45);
}
.stat-label {
  position: relative;
  z-index: 2;
  font-size: 21rpx;
  font-weight: 800;
  color: #FFF1DC;
  margin-top: 6rpx;
  --sk: none;
  text-shadow: 0 1.5rpx 0 rgba(110,24,10,.55);
}
/* 三连块配色与角度：写死但每块不同，形成"随意摆放"的手感 */
.stat:nth-child(1) { transform: rotate(-2.4deg) translateY(3rpx); }
.stat:nth-child(2) {
  transform: rotate(1.6deg) translateY(-2rpx);
  --c: var(--blue-c); --ft: var(--blue-ft); --fb: var(--blue-fb);
  --fb2: var(--blue-fb2); --sd: var(--blue-sd); --e: var(--blue-e);
}
.stat:nth-child(2) .stat-num { --sk: #062A52; }
.stat:nth-child(3) {
  transform: rotate(-1deg) translateY(2rpx);
  --c: var(--yellow-c); --ft: var(--yellow-ft); --fb: var(--yellow-fb);
  --fb2: var(--yellow-fb2); --sd: var(--yellow-sd); --e: var(--yellow-e);
}
.stat:nth-child(3) .stat-num { color: var(--btn-yellow-num); --sk: #765008; }
.stat:nth-child(3) .stat-label { color: var(--ink); text-shadow: none; }

/* --- .bar → 分段进度条 --- */
.bar {
  position: relative;
  height: 26rpx;
  border-radius: 8rpx;
  background: #E3CBA6;
  overflow: hidden;
  box-shadow: inset 0 3rpx 5rpx rgba(120,80,30,.2);
}
.bar-fill {
  position: relative;
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #FFD976, #FFC53D 60%, #F0AE22);
  transition: width .45s var(--ease);
  box-shadow: inset 0 -3rpx 0 rgba(190,140,20,.35), 0 0 14rpx rgba(255,197,61,.7);
}
.bar-fill::after { display: none; }
.bar-seg {
  position: absolute;
  top: 0; bottom: 0;
  border-radius: 8rpx;
  background: rgba(47,143,224,.28);
}

/* ===================== 文字 ===================== */
.h1 { font-size: 44rpx; font-weight: 900; letter-spacing: -0.01em; }
.h2 { font-size: 34rpx; font-weight: 900; }
.sub { font-size: 26rpx; color: var(--ink-2); }
.muted { font-size: 24rpx; color: var(--ink-mute); }
.strong { font-weight: 900; }
.center { text-align: center; }
.tip-link { color: var(--accent-hot); font-weight: 800; }

/* ===================== 布局 ===================== */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.gap-sm { gap: 16rpx; }
.gap { gap: 24rpx; }
.flex1 { flex: 1; }
.wrap { flex-wrap: wrap; }

/* ===================== 列表行 ===================== */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 3rpx dashed var(--dash);
}
.list-item:last-child { border-bottom: none; }

/* ===================== 空状态 ===================== */
.empty { padding: 90rpx 40rpx; text-align: center; }
.empty-text { font-size: 28rpx; color: var(--ink-mute); margin-bottom: 32rpx; line-height: 1.9; }

/* ===================== 分隔 ===================== */
.divider { height: 3rpx; background: var(--dash); margin: 24rpx 0; border-radius: 3rpx; }

/* ===================== 动效 ===================== */
@keyframes wbRiseIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; }
}
@keyframes wbPopIn {
  0% { opacity: 0; transform: scale(.9); }
  22% { opacity: 1; }
  62% { transform: scale(1.025); }
  100% { transform: scale(1); }
}
@keyframes wbShake {
  0%, 100% { transform: translateX(0); }
  12% { transform: translateX(-12rpx); }
  28% { transform: translateX(10rpx); }
  44% { transform: translateX(-8rpx); }
  60% { transform: translateX(6rpx); }
  76% { transform: translateX(-4rpx); }
}
.rise { animation: wbRiseIn .46s var(--ease) both; }
.pop { animation: wbPopIn .42s var(--spring) both; }
.shake { animation: wbShake .5s var(--ease) both; }
@keyframes wbSpin { to { transform: rotate(360deg); } }
@keyframes wbPulse {
  0%, 100% { transform: scale(1); opacity: .9; }
  50% { transform: scale(1.06); opacity: 1; }
}

/* ===================== 页面转场 =====================
 * navigateTo 的动画由系统控制改不了，所以在内容层补入场。
 */
@keyframes wbPageIn {
  from { opacity: 0; transform: translateY(48rpx) scale(.992); }
  to { opacity: 1; }
}
@keyframes wbPageInSide {
  from { opacity: 0; transform: translateX(120rpx) scale(.985); }
  to { opacity: 1; }
}
@keyframes wbPageInUp {
  from { opacity: 0; transform: translateY(120rpx) scale(.94); }
  60% { opacity: 1; }
  to { opacity: 1; }
}
.page-in { animation: wbPageIn .48s var(--ease) both; }
.page-in-side { animation: wbPageInSide .5s var(--ease) both; }
.page-in-up { animation: wbPageInUp .62s var(--spring) both; }

/* 卡片错峰：只作用于直接子级。前两个子级是氛围层，延迟从第 3 个算起。
 * 注意 WXSS 不支持 `*` 通配符，用标签选择器等价替代。 */
.page-in > .card,
.page-in-side > .card,
.page-in-up > .card,
.page-in > .brick,
.page-in-side > .brick,
.page-in-up > .brick { animation: wbRiseIn .5s var(--ease) both; }
.page-in > view:nth-child(3),
.page-in-side > view:nth-child(3),
.page-in-up > view:nth-child(3) { animation-delay: .03s; }
.page-in > view:nth-child(4),
.page-in-side > view:nth-child(4),
.page-in-up > view:nth-child(4) { animation-delay: .08s; }
.page-in > view:nth-child(5),
.page-in-side > view:nth-child(5),
.page-in-up > view:nth-child(5) { animation-delay: .13s; }
.page-in > view:nth-child(6),
.page-in-side > view:nth-child(6),
.page-in-up > view:nth-child(6) { animation-delay: .18s; }
.page-in > view:nth-child(7),
.page-in-side > view:nth-child(7),
.page-in-up > view:nth-child(7) { animation-delay: .23s; }
@keyframes wbSweep {
  from { transform: translateX(-120%); }
  to { transform: translateX(120%); }
}

/* ===================== 吉祥物：柯基豆豆 =====================
 * 位图：assets/images/mascot-corgi.png（160×255，透明底 + 2px 白描边）。
 *
 * 为什么加白描边：狗的毛色和背景白几乎同色（239~251 的暖白），软边过渡
 * 用色差切不掉，切完会留一圈浅色晕。给一圈白边，把"晕"变成有意的贴纸边，
 * 和全站 .sticker 文字描边是同一套视觉语言。
 *
 * 尺寸：宽 188rpx ≈ 手机 94px，2 倍屏 188 设备像素 ≈ 源图 160px 的 1.17 倍，
 * 基本 1:1，不发虚。
 */
.mascot {
  display: block;
  width: 188rpx;
  height: 300rpx;
  animation: mascotBob 4.2s ease-in-out infinite;
  filter: drop-shadow(0 10rpx 12rpx rgba(120, 60, 10, .3));
}
@keyframes mascotBob {
  0%, 100% { transform: rotate(-3.5deg) translateY(0); }
  50%      { transform: rotate(-1deg) translateY(-10rpx); }
}
