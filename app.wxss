/* ===== 字体 =====
 * Baloo 2 ExtraBold：圆润、宽厚、笔画末端带弧度，接近儿童绘本标题字。
 * 只含拉丁字母（约 18KB，base64 内联），中文自动回落到系统字体——
 * 这是刻意的：中文字库动辄几 MB，塞进主包会直接撞上 2MB 上限。
 * 效果上英文单词、数字、按钮文案都变成圆胖体，中文保持系统字重，
 * 混排时反而层次更清楚。
 */
@font-face {
  font-family: 'WBDisplay';
  src: url('data:font/woff2;base64,') format('woff2');
  font-weight: 400 900;
  font-style: normal;
  font-display: swap;
}

/* ===== 全局设计令牌 =====
 * 方向：玩趣玩具（糖果手账），给 6-12 岁孩子用，但要家长看着放心。
 *   主色   深靛蓝（学院感）
 *   强调色 珊瑚橙（全站唯一强调色，只留给关键动作与正向反馈）
 *   底色   温暖米白，不用冷灰——冷灰会让界面像后台管理系统
 * 所有组件只引用变量，不在页面里硬编码色值。
 */
page {
  --primary: #27386E;
  --primary-soft: #E7EBF7;
  --accent: #FF6B3D;
  --accent-ink: #3B1608;      /* 橙底上的文字色：深棕黑，对比度 5.9:1 */
  --accent-soft: #FFEDE4;
  --bg: #F8F3E9;
  --card: #FFFFFF;
  --text: #1C2333;
  --text-sub: #5A6377;
  --muted: #6E7789;           /* 小字也满足 4.5:1，不用更浅的灰 */
  --line: #E6DCCB;
  --line-soft: #F1EADD;
  --success: #0C9A6C;
  --success-soft: #DEF6EC;
  --warn: #B87400;
  --warn-soft: #FDF2DC;
  --danger: #D8474A;
  --danger-soft: #FBEAEA;

  /* 荧光色：只用在"发光"上，不做填充色，否则界面会变脏 */
  --glow-coral: rgba(255, 107, 61, 0.55);
  --glow-indigo: rgba(86, 116, 214, 0.45);
  --glow-mint: rgba(78, 205, 196, 0.4);

  --r-lg: 34rpx;
  --r-md: 24rpx;
  --r-pill: 999rpx;
  --shadow-1: 0 2rpx 4rpx rgba(26, 39, 80, 0.04), 0 16rpx 40rpx -18rpx rgba(26, 39, 80, 0.3);
  --shadow-2: 0 30rpx 60rpx -24rpx rgba(26, 39, 80, 0.35);
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --font-display: 'WBDisplay', -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;

  background: var(--bg);
  color: var(--text);
  font-family: var(--font-display);
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* ===== 氛围背景 =====
 * 两层：
 *   .fx-bg   漂浮的颗粒（径向渐变平铺 + 缓慢位移，看起来像空气中浮尘）
 *   .fx-glow 三团大范围荧光，压在四角，给画面纵深
 * 都是纯 CSS，不占包体积、不用图片、不影响滚动性能（只动 background-position）。
 */
.fx-bg {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}
.fx-bg::before,
.fx-bg::after {
  content: '';
  position: absolute;
  left: -20%;
  top: -20%;
  width: 140%;
  height: 140%;
  background-repeat: repeat;
}
/* 近景颗粒：大一点、亮一点、动得快 */
.fx-bg::before {
  background-image:
    radial-gradient(circle, rgba(255, 107, 61, 0.5) 0 3rpx, transparent 4rpx),
    radial-gradient(circle, rgba(39, 56, 110, 0.28) 0 2rpx, transparent 3rpx);
  background-size: 190rpx 190rpx, 130rpx 130rpx;
  background-position: 0 0, 40rpx 70rpx;
  opacity: 0.55;
  animation: fxDriftA 34s linear infinite;
}
/* 远景颗粒：小、淡、慢，形成前后视差 */
.fx-bg::after {
  background-image:
    radial-gradient(circle, rgba(78, 205, 196, 0.42) 0 2rpx, transparent 3rpx),
    radial-gradient(circle, rgba(255, 176, 58, 0.42) 0 3rpx, transparent 4rpx);
  background-size: 260rpx 260rpx, 330rpx 330rpx;
  background-position: 90rpx 20rpx, 200rpx 120rpx;
  opacity: 0.42;
  animation: fxDriftB 52s linear infinite reverse;
}

/* 荧光团：不参与动画，只做"光打进来"的静态氛围 */
.fx-glow {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: -1;
  pointer-events: none;
  background:
    radial-gradient(420rpx 420rpx at 8% -4%, rgba(255, 107, 61, 0.2), transparent 72%),
    radial-gradient(520rpx 520rpx at 104% 12%, rgba(86, 116, 214, 0.18), transparent 70%),
    radial-gradient(600rpx 600rpx at 46% 108%, rgba(78, 205, 196, 0.14), transparent 74%);
}

@keyframes fxDriftA {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(-190rpx, -190rpx, 0); }
}
@keyframes fxDriftB {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(260rpx, -260rpx, 0); }
}

.page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 卡片 =====
 * 荧光版：边框用渐变描边（mask 太贵，这里用双层 box-shadow 近似），
 * 顶部一道高光让卡片看起来是"微微凸起的糖片"。
 */
.card {
  position: relative;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFDF8 100%);
  border-radius: var(--r-lg);
  padding: 32rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow:
    0 2rpx 4rpx rgba(26, 39, 80, 0.04),
    0 16rpx 40rpx -18rpx rgba(26, 39, 80, 0.3);
  overflow: hidden;
}
/* 卡片顶部一缕高光，模拟塑料/糖果表面反光 */
.card::before {
  content: '';
  position: absolute;
  left: 6%;
  right: 6%;
  top: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95), transparent);
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  letter-spacing: 0.01em;
}

/* ===== 文字 ===== */
.h1 { font-size: 46rpx; font-weight: 800; letter-spacing: -0.015em; }
.h2 { font-size: 34rpx; font-weight: 800; }
.sub { font-size: 26rpx; color: var(--text-sub); }
.muted { font-size: 24rpx; color: var(--muted); }
.strong { font-weight: 800; }
.center { text-align: center; }
.tip-link { color: var(--accent); font-weight: 700; }

/* ===== 按钮 =====
 * 立体按压是整套界面的手感核心：底部实心投影当"厚度"，
 * 按下时按钮真的往下沉、投影收掉，像按一颗糖。
 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 28rpx;
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0.02em;
  border: none;
  line-height: 1;
  transition: transform 0.12s var(--ease), box-shadow 0.12s var(--ease), filter 0.12s;
}
.btn::after { border: none; }

/* 主动作：珊瑚橙 */
.btn-primary {
  background: linear-gradient(180deg, #FF9B6E 0%, #FF6B3D 52%, #F5582A 100%);
  color: var(--accent-ink);
  box-shadow: 0 6rpx 0 #C7431C, 0 20rpx 36rpx -16rpx rgba(242, 84, 42, 0.8);
}
.btn-primary:active {
  transform: translateY(6rpx);
  box-shadow: 0 0 0 #C7431C, 0 8rpx 16rpx -8rpx rgba(242, 84, 42, 0.5);
}

/* 次动作：深靛。答错后的"下一题"用它，比橙色冷静 */
.btn-accent {
  background: linear-gradient(180deg, #3B4F91 0%, #27386E 100%);
  color: #fff;
  box-shadow: 0 6rpx 0 #16224A, 0 20rpx 36rpx -16rpx rgba(39, 56, 110, 0.7);
}
.btn-accent:active {
  transform: translateY(6rpx);
  box-shadow: 0 0 0 #16224A, 0 8rpx 16rpx -8rpx rgba(39, 56, 110, 0.45);
}

.btn-ghost {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid #D6DEEE;
  box-shadow: 0 4rpx 0 rgba(26, 39, 80, 0.06);
}
.btn-ghost:active { transform: translateY(4rpx); box-shadow: 0 0 0 rgba(26, 39, 80, 0.06); }

.btn-danger-ghost {
  background: #fff;
  color: var(--danger);
  border: 2rpx solid rgba(216, 71, 74, 0.28);
  box-shadow: 0 4rpx 0 rgba(216, 71, 74, 0.1);
}
.btn-danger-ghost:active { transform: translateY(4rpx); box-shadow: 0 0 0 rgba(216, 71, 74, 0.1); }

.btn-sm { height: 66rpx; font-size: 27rpx; padding: 0 32rpx; border-radius: 22rpx; }

/* 禁用：灰阶下沉，不能有"厚度"，否则会被误认为可点 */
.btn[disabled] {
  background: #DCE1EA;
  color: #8B93A3;
  box-shadow: 0 6rpx 0 #B5BDCB;
  opacity: 1;
  transform: none;
}

/* 真机上 :active 对自定义按钮并不可靠，按压感统一交给 hover-class="btn-press"。
 * 表现与 :active 一致：整体下沉、投影收掉，像真的按下去。 */
.btn-press {
  transform: translateY(6rpx) scale(0.985);
  filter: brightness(0.97);
}
.btn-press.btn-primary {
  box-shadow: 0 0 0 #C7431C, 0 8rpx 16rpx -8rpx rgba(242, 84, 42, 0.5);
}
.btn-press.btn-accent {
  box-shadow: 0 0 0 #16224A, 0 8rpx 16rpx -8rpx rgba(39, 56, 110, 0.45);
}
.btn-press.btn-ghost {
  box-shadow: 0 0 0 rgba(26, 39, 80, 0.06);
}
.btn-press.btn-danger-ghost {
  box-shadow: 0 0 0 rgba(216, 71, 74, 0.1);
}

/* ===== 布局 ===== */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.gap-sm { gap: 16rpx; }
.gap { gap: 24rpx; }
.flex1 { flex: 1; }
.wrap { flex-wrap: wrap; }

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  background: var(--accent-soft);
  color: #B03D0F;
  line-height: 1.6;
  font-weight: 700;
}
.tag-primary { background: var(--primary-soft); color: var(--primary); }
.tag-success { background: var(--success-soft); color: var(--success); }
.tag-warn { background: var(--warn-soft); color: var(--warn); }

/* ===== 统计格 ===== */
.stat-grid {
  display: flex;
  gap: 20rpx;
}
.stat {
  flex: 1;
  position: relative;
  background: linear-gradient(180deg, #FBF7EE, #F6EFE1);
  border-radius: var(--r-md);
  padding: 24rpx 20rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  overflow: hidden;
}
.stat-num {
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 800;
  color: var(--primary);
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

/* ===== 列表行 ===== */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.list-item:last-child { border-bottom: none; }

/* ===== 进度条 =====
 * 渐变 + 一道白光循环流过，让"进度"这件事有生命感
 */
.bar {
  position: relative;
  height: 14rpx;
  border-radius: var(--r-pill);
  background: var(--line-soft);
  overflow: hidden;
}
.bar-fill {
  position: relative;
  height: 100%;
  border-radius: var(--r-pill);
  background: linear-gradient(90deg, #FFC24A, #FF6B3D 70%, #F2542A);
  box-shadow: 0 0 16rpx rgba(255, 107, 61, 0.65);
  transition: width 0.55s var(--ease);
  overflow: hidden;
}
.bar-fill::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(100deg, transparent 20%, rgba(255, 255, 255, 0.85) 50%, transparent 80%);
  animation: barShine 2.4s linear infinite;
}
@keyframes barShine {
  from { transform: translateX(-110%); }
  to { transform: translateX(110%); }
}

/* ===== 空状态 ===== */
.empty {
  padding: 96rpx 40rpx;
  text-align: center;
}
.empty-text { font-size: 28rpx; color: var(--muted); margin-bottom: 32rpx; line-height: 1.9; }

/* ===== 分隔 ===== */
.divider { height: 1rpx; background: var(--line-soft); margin: 24rpx 0; }

/* ===== 动效 ===== */
@keyframes wbRiseIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: none; }
}
@keyframes wbPopIn {
  0% { opacity: 0; transform: scale(0.9); }
  22% { opacity: 1; }
  62% { transform: scale(1.025); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes wbShake {
  0%, 100% { transform: translateX(0); }
  12% { transform: translateX(-12rpx); }
  28% { transform: translateX(10rpx); }
  44% { transform: translateX(-8rpx); }
  60% { transform: translateX(6rpx); }
  76% { transform: translateX(-4rpx); }
}

/* 只在需要时给单个容器加入场，列表类页面不加，避免每次 setData 都重播 */
.rise { animation: wbRiseIn 0.46s var(--ease) both; }
.pop { animation: wbPopIn 0.42s var(--spring) both; }
.shake { animation: wbShake 0.5s var(--ease) both; }

/* ===== 页面转场 =====
 * 小程序的 navigateTo/navigateBack 动画由系统控制，改不了。
 * 所以在"内容层"补一段入场：整页从下方浮起 + 轻微缩放，卡片再错峰跟上。
 * 三个方向对应三种去向，和用户在浏览器预览版看到的一致：
 *   page-in       普通进入（从下浮起）
 *   page-in-side  进入学习（从右推入，呼应 navigateTo 的方向）
 *   page-in-up    到达结算（从下弹起，强调"完成"）
 */
@keyframes wbPageIn {
  from { opacity: 0; transform: translateY(48rpx) scale(0.992); }
  to { opacity: 1; transform: none; }
}
@keyframes wbPageInSide {
  from { opacity: 0; transform: translateX(120rpx) scale(0.985); }
  to { opacity: 1; transform: none; }
}
@keyframes wbPageInUp {
  from { opacity: 0; transform: translateY(120rpx) scale(0.94); }
  60% { opacity: 1; }
  to { opacity: 1; transform: none; }
}

.page-in { animation: wbPageIn 0.48s var(--ease) both; }
.page-in-side { animation: wbPageInSide 0.5s var(--ease) both; }
.page-in-up { animation: wbPageInUp 0.62s var(--spring) both; }

/* 卡片错峰：只作用在页面直接子级，避免深层重排 */
.page-in > .card,
.page-in-side > .card,
.page-in-up > .card,
.page-in > .hero,
.page-in-side > .hero,
.page-in-up > .hero {
  animation: wbRiseIn 0.5s var(--ease) both;
}
/* 前两个子级是氛围层（.fx-glow / .fx-bg），没有动画也不该占位，
 * 所以错峰延迟从第 3 个子级开始算。
 * 注意：WXSS 不支持 `*` 通配符（编译会直接报错），这里用 view 标签选择器等价替代。 */
.page-in > view:nth-child(3),
.page-in-side > view:nth-child(3),
.page-in-up > view:nth-child(3) { animation-delay: 0.03s; }
.page-in > view:nth-child(4),
.page-in-side > view:nth-child(4),
.page-in-up > view:nth-child(4) { animation-delay: 0.08s; }
.page-in > view:nth-child(5),
.page-in-side > view:nth-child(5),
.page-in-up > view:nth-child(5) { animation-delay: 0.13s; }
.page-in > view:nth-child(6),
.page-in-side > view:nth-child(6),
.page-in-up > view:nth-child(6) { animation-delay: 0.18s; }
.page-in > view:nth-child(7),
.page-in-side > view:nth-child(7),
.page-in-up > view:nth-child(7) { animation-delay: 0.23s; }

/* 答对时卡片扫过一道光：把"对了"这件事做得有质感 */
@keyframes wbSweep {
  from { transform: translateX(-120%); }
  to { transform: translateX(120%); }
}

/* ===== 吉祥物（纯 CSS 绘制） =====
 * 不用图片的原因：
 *   1) 主包已用掉 72%，一张像样的插画 PNG 至少 60KB，而这个是 0 字节
 *   2) 矢量级的圆角在任意 DPR 下都不糊，真机不会出现锯齿
 *   3) 颜色直接引用设计令牌，改主题色时它会跟着变
 * 结构：耳朵 ×2 + 身体 + 肚皮 + 眼睛 ×2（含瞳孔）+ 喙
 */
.mascot {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  animation: mascotBob 3.6s ease-in-out infinite;
}

@keyframes mascotBob {
  0%, 100% { transform: translateY(0) rotate(-4deg); }
  50% { transform: translateY(-10rpx) rotate(4deg); }
}

/* 尖耳朵在小尺寸下会被读成猫/狐狸，改成头顶一撮呆毛，更像小鸟 */
.m-ear {
  position: absolute;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF8A5C;
  opacity: 0.95;
}
.m-ear.l { left: 26rpx; }
.m-ear.r { left: 56rpx; top: 2rpx; transform: scale(0.78); }

.m-body {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 12rpx;
  bottom: 0;
  border-radius: 52% 52% 46% 46%;
  background: linear-gradient(160deg, #FFB47E 0%, #FF6B3D 58%, #E14E28 100%);
  box-shadow:
    inset 0 -10rpx 16rpx rgba(150, 40, 10, 0.28),
    inset 0 6rpx 10rpx rgba(255, 255, 255, 0.4),
    0 10rpx 20rpx -10rpx rgba(242, 84, 42, 0.75);
  overflow: hidden;
}

.m-belly {
  position: absolute;
  left: 24%;
  right: 24%;
  bottom: 5%;
  height: 34%;
  border-radius: 50% 50% 46% 46%;
  background: linear-gradient(180deg, rgba(255, 249, 236, 0.72), rgba(255, 236, 210, 0.9));
}

.m-eye {
  position: absolute;
  top: 20%;
  width: 29rpx;
  height: 29rpx;
  border-radius: 50%;
  background: #FFF9F0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -3rpx 5rpx rgba(120, 60, 20, 0.22);
}
.m-eye.l { left: 15%; }
.m-eye.r { right: 15%; }

.m-pupil {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: inset 3rpx -3rpx 0 rgba(255, 255, 255, 0.55);
}

.m-beak {
  position: absolute;
  left: 50%;
  top: 56%;
  margin-left: -9rpx;
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-top: 14rpx solid #FFC24A;
}
